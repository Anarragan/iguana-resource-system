# Copia a .env (que NO se versiona) y completa.

# Conexión de la API. Usa el rol de mínimo privilegio creado al final de db/migrations/004
# (api_formulario, miembro de rol_formulario), NO el dueño ni service_role.
DATABASE_URL=postgresql://api_formulario:CLAVE@HOST:5432/postgres
# DATABASE_SSL=disable          # solo para una base local sin SSL
# DATABASE_SSL_STRICT=true      # validar el certificado del servidor (recomendado si tu proveedor lo permite)

# Claves de la API (cabecera x-api-key), separadas por coma para poder rotar. Mínimo 24 caracteres cada una.
# Generar:  node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
API_KEYS=

# Orígenes del front permitidos, separados por coma. En producción, sin esto se rechaza todo origen.
CORS_ORIGIN=https://tu-front.example.com

# Peticiones por IP y minuto (opcional, 240 por defecto).
# RATE_LIMIT_PER_MIN=240
